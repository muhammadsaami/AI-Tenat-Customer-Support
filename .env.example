# SupportPilot Environment Configuration
# Copy this file to .env and fill in real values

# Application
APP_NAME=SupportPilot
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-64-char-string
# Schema management: use 'alembic upgrade head' in production.
# Set true ONLY for local/test convenience (create_all shortcut).
AUTO_CREATE_TABLES=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/supportpilot

# Redis
REDIS_URL=redis://localhost:6380/0

# Groq (LLM provider)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# JWT — use a long random string, >= 32 chars
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
# Access token lifetime (short-lived; refresh via /auth/refresh)
JWT_EXPIRE_MINUTES=15
# Refresh-token family lifetime
JWT_REFRESH_EXPIRE_DAYS=30
REFRESH_TOKEN_BYTES=48

# Multitenancy
TENANT_HEADER=X-Tenant-ID

# Vector store
CHROMA_PERSIST_DIR=./chroma_data

# Login rate limiting (in-process sliding window: failed attempts per IP+email)
# LOGIN_RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
